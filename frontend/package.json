{
  "name": "ai-ui-explorer-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "element-plus": "2.10.4",
    "vue": "3.5.18"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@types/node": "24.1.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.31.0",
    "eslint-plugin-vue": "10.3.0",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vite": "7.0.6",
    "vitest": "3.2.4",
    "vue-tsc": "3.0.4"
  },
  "packageManager": "pnpm@11.9.0"
}
